<launch>
    <!--
    hector_lidar.launch
    ============================================
    Launch file for running HectorSLAM using LIDAR and odometry.

    It runs:
      - hector_mapping to perform SLAM based on laser scans
      - static_transform_publisher to define laser position relative to robot base

    Developed for ROS Melodic + LIDAR A1 connected via serial
    -->

    <!-- ========== 1. HectorSLAM core node ========== -->
    <node
        pkg="hector_mapping"
        type="hector_mapping"
        name="hector_mapping"
        output="screen">
        <param name="base_frame" value="base_link"/>
        <param name="odom_frame" value="odom"/>
        <param name="map_frame" value="map"/>
        <param name="pub_map_odom_transform" value="true"/>
        <param name="use_tf_scan_transformation" value="true"/>
        <param name="use_tf_pose_start_estimate" value="true"/>
        <param name="map_update_interval" value="2.0"/>
        <param name="transform_tolerance" value="0.2"/>
    </node>

    <!-- ========== 2. Static transform: base_link → laser ========== -->
    <node
        pkg="tf"
        type="static_transform_publisher"
        name="base_to_laser"
        args="0 0 0 0 0 0 base_link laser 100"/>
</launch>
